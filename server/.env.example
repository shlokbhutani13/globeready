# Copy to server/.env for LOCAL DEVELOPMENT ONLY. Never commit a real .env file.
# The full contract, including which values are required in production, is docs/CONFIGURATION.md.
# Placeholder values are refused in production, so an unedited copy of this file cannot start a production server.

# ---- Mode -------------------------------------------------------------------------------------------------------
# Leave both flags unset for production (real Firebase only). Setting either to true is refused when NODE_ENV=production.
# DEMO_MODE=true              development demo with in-memory sample data; accepts the x-demo-user header.
# LOCAL_USER_MODE=true        local emulators with a persistent local account (use: cd client && npm run local-user).
DEMO_MODE=false

# ---- Server -----------------------------------------------------------------------------------------------------
PORT=5051
# Browser origin(s) allowed to call the API, comma-separated. Origin only: no path, query, or trailing slash.
# Production requires an https origin.
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info
# Shutdown bound in milliseconds (1000 to 60000).
SHUTDOWN_TIMEOUT_MS=10000
# Trust X-Forwarded-For only behind a known proxy: "false", "loopback", or a hop count 1 to 3.
TRUST_PROXY=false
# Build metadata for /api/health. Letters, digits, dot, underscore, hyphen.
BUILD_ID=

# ---- Firebase (production) ---------------------------------------------------------------------------------------
# Either set the explicit service-account pair, or leave both empty and use Application Default Credentials.
# Production requires FIREBASE_PROJECT_ID and FIREBASE_STORAGE_BUCKET. The bucket is needed to delete stored files.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Users allowed to open the admin news review screen (comma-separated Firebase UIDs).
ADMIN_UIDS=

# ---- Rate limiting -----------------------------------------------------------------------------------------------
# The limiter is per process. Production must declare that it runs a single instance; otherwise it refuses to start.
RATE_LIMIT_SCOPE=
AI_REQUESTS_PER_MINUTE=12
NEWS_QUERIES_PER_MINUTE=60
NEWS_SOURCE_SUGGESTIONS_PER_HOUR=5
NEWS_ADMIN_MUTATIONS_PER_MINUTE=30
ACCOUNT_EXPORTS_PER_HOUR=6
ACCOUNT_DELETIONS_PER_HOUR=5

# ---- Gemini answers (optional, server-side only) -----------------------------------------------------------------
# Leave GEMINI_API_KEY empty to keep document answers in the "retrieved passages" state. Never place a key in the client.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000
# Not supported in this release. Must stay false.
GEMINI_EMBEDDINGS_ENABLED=false
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---- Documents ---------------------------------------------------------------------------------------------------
# Local OCR for PNG and JPEG photos of printed text. Runs on this server; sends nothing to a provider.
DOCUMENT_OCR_ENABLED=true

# ---- Official source synchronization -----------------------------------------------------------------------------
# Disabled by default. Live synchronization also needs a fenced snapshot store and an approved scheduler.
NEWS_SYNC_ENABLED=false
# Bearer secret for POST /api/internal/news/sync (at least 16 characters). Required when NEWS_SYNC_ENABLED=true.
NEWS_SYNC_SECRET=
