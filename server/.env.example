# Copy to server/.env for local development. Never commit real values.
PORT=5051
CLIENT_URL=http://localhost:5173

# Authentication. DEMO_MODE=true is the only way to use the x-demo-user identity; it is refused when NODE_ENV=production.
# Leave unset or false for any deployment. Local demo: set DEMO_MODE=true and NODE_ENV=development.
DEMO_MODE=false

# Firebase Admin. Without DEMO_MODE=true the server refuses to start unless these are valid.
# Use either the explicit service-account pair below, or Application Default Credentials
# (GOOGLE_APPLICATION_CREDENTIALS or an attached service account) with FIREBASE_PROJECT_ID set.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Users allowed to open the admin news review screen (comma-separated Firebase UIDs).
ADMIN_UIDS=

# Gemini answers. Leave empty to keep document answers in the "unavailable" state.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Inert at launch. Only read when GEMINI_EMBEDDINGS_ENABLED=true, which is not supported for launch.
GEMINI_EMBEDDINGS_ENABLED=false
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Local OCR for PNG/JPEG documents (runs on this server; no external provider). Set to false to disable.
DOCUMENT_OCR_ENABLED=true

# Request limits.
AI_REQUESTS_PER_MINUTE=12
NEWS_QUERIES_PER_MINUTE=60
NEWS_SOURCE_SUGGESTIONS_PER_HOUR=5
NEWS_ADMIN_MUTATIONS_PER_MINUTE=30

# Official source synchronization. Disabled by default; enabling it fetches public government and university sources.
NEWS_SYNC_ENABLED=false
NEWS_SYNC_SECRET=
