{
  "type": "module",
  "name": "globeready-api",
  "version": "1.0.0",
  "description": "Authenticated API for the GlobeReady international student workspace",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "demo": "DEMO_MODE=true NODE_ENV=development node src/index.js",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,auth,storage --project globeready-test \"vitest run tests/firestore-rules-emulator.test.js tests/firestore-account-emulator.test.js tests/account-emulator.test.js tests/storage-rules-emulator.test.js tests/local-user-mode.test.js\"",
    "lint": "node --check src/index.js && node --check src/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.32.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "firebase-admin": "^14.1.0",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.30.1",
    "supertest": "^7.1.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@fastify/busboy": "3.2.2",
    "@grpc/grpc-js": "1.14.5",
    "brace-expansion": "2.1.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
