# Copy to client/.env.zero-cost-public.local, which Git ignores. Every value is public and compiled into the
# browser bundle, but keep project settings out of commits anyway.
VITE_ZERO_COST_PUBLIC=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Deliberately absent in this runtime: VITE_API_URL, VITE_FIREBASE_STORAGE_BUCKET,
# VITE_DOCUMENT_UPLOADS_ENABLED, emulator flags, service credentials, and AI keys.
