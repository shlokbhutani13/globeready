# Local-user mode only (vite --mode local-user). Placeholder identifiers for the local emulators; not credentials.
VITE_LOCAL_USER_MODE=true
VITE_API_URL=http://localhost:5051
VITE_FIREBASE_API_KEY=globeready-local-emulator
VITE_FIREBASE_AUTH_DOMAIN=globeready-local.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=globeready-local
VITE_FIREBASE_STORAGE_BUCKET=globeready-local.appspot.com
VITE_FIREBASE_APP_ID=1:0:web:globeready-local
VITE_DOCUMENT_UPLOADS_ENABLED=true
