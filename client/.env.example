# Copy to client/.env.local for local development. Firebase web-app values are public identifiers; the rules enforce access.
VITE_API_URL=http://localhost:5051
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Shows document upload controls. Only enable for a deployment whose Storage rules are deployed.
VITE_DOCUMENT_UPLOADS_ENABLED=false
