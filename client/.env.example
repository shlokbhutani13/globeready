# Copy to client/.env.local for LOCAL DEVELOPMENT. Every VITE_ value is PUBLIC: it is compiled into the browser bundle.
# Never put a secret, service-account key, or Gemini key in a VITE_ variable.

# API origin. Production builds require an https origin and have no localhost fallback.
VITE_API_URL=http://localhost:5051

# Firebase web-app identifiers are public. Access is enforced by Firestore and Storage rules, not by hiding these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Shows document upload controls. Enable only for a deployment whose Storage rules are deployed.
VITE_DOCUMENT_UPLOADS_ENABLED=false
